# ======================================================================
# indigo-tarot 环境变量示例
# 复制本文件为 .env.local（本地开发）或配置到 Vercel（生产）
# 参考 docs/DEPLOYMENT.md
# ======================================================================

# ===== DeepSeek API（必填）=====
# 系统 Key：免费试用与每日熔断配额的资金来源
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek 接口地址（可选，默认 https://api.deepseek.com/v1）
# DEEPSEEK_API_URL=https://api.deepseek.com/v1

# ===== 每日熔断配额（可选，默认 50）=====
# 系统 Key 每天（自然日，Asia/Shanghai 0 点起算）最多调用次数
QUOTA_DAILY_LIMIT=50

# ===== 管理接口认证（必填）=====
# 用于调用 /api/admin/quota 开关接口；生成方式：openssl rand -hex 16
# 生产环境务必重新生成，不要复用本地/示例值
ADMIN_TOKEN=replace-with-a-random-hex-string

# ===== Upstash Redis（生产强烈推荐）=====
# 免费试用/限流/配额计数的跨实例 + 持久化存储；不配置则回退单实例内存（重启清零）
# 获取：https://console.upstash.com 创建 Redis → 复制 REST URL 与 REST Token
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxx
