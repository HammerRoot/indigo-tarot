# ======================================================================
# indigo-tarot 环境变量示例
# 复制本文件为 .env.local（本地开发）或配置到服务器（生产，见 docs/DEPLOYMENT.md）
# 参考 docs/DEPLOYMENT.md
# ======================================================================

# ===== DeepSeek API（必填）=====
# 系统 Key：免费试用与每日熔断配额的资金来源
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek 接口地址（可选，默认 https://api.deepseek.com/v1）
# DEEPSEEK_API_URL=https://api.deepseek.com/v1

# ===== 每日熔断配额（可选，默认 50）=====
# 系统 Key 每天（自然日，Asia/Shanghai 0 点起算）最多调用次数
QUOTA_DAILY_LIMIT=50

# ===== 管理接口认证（必填）=====
# 用于调用 /api/admin/quota 开关接口；生成方式：openssl rand -hex 16
# 生产环境务必重新生成，不要复用本地/示例值
ADMIN_TOKEN=replace-with-a-random-hex-string

# ===== Redis（生产强烈推荐，服务器自建）=====
# 免费试用（每设备一次）/限流/配额计数的持久化存储；
# 不配置则回退单实例内存：服务重启/冷启动即清零，免费试用会"复活"（无法保证"每设备一次"）
# 自建方式：apt install redis-server，设置 requirepass + appendonly yes（见 docs/MIGRATION_CN_ARCHIVE.md §4.4）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=xxxxxxxxxxxxxxxx
